# ---------- App ----------
NODE_ENV=development
APP_MODE=api               # api | worker
PORT=3000
LOG_FORMAT=pretty          # pretty | json

# ---------- PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=bank
DB_PASSWORD=bank_password
DB_NAME=bank
DB_RUN_MIGRATIONS=true
DB_SSL=false               # true for AWS RDS     # docker/k8s run a separate migration job instead

# ---------- Kafka ----------
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=banking-api
KAFKA_CONSUMER_GROUP=banking-notifications
KAFKA_SSL=false            # true for AWS MSK

# ---------- AI (Ollama + LangChain) ----------
AI_PROVIDER=ollama         # ollama | fake (fake = deterministic, no model needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:1b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
AI_AUTO_INGEST=true
KNOWLEDGE_DIR=./knowledge

# ---------- Business rules ----------
INTERNAL_TRANSFER_FEE_MINOR=0
FRAUD_RULES=amount > 5000000 AND channel == 'mobile';hour < 5 AND amount > 1000000
