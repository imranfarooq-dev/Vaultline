{
  "name": "nest-banking-patterns",
  "version": "1.0.0",
  "description": "Enterprise-style NestJS banking app that teaches all 23 GoF design patterns, with PostgreSQL, Kafka, Ollama, LangChain RAG, Docker and Kubernetes.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:worker": "APP_MODE=worker node dist/main.js",
    "migration:run": "node dist/database/run-migrations.js",
    "seed:knowledge": "node dist/modules/ai/scripts/ingest-knowledge.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "jest --selectProjects unit",
    "test:unit": "jest --selectProjects unit",
    "test:contract": "jest --selectProjects contract",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "test:all": "jest --runInBand",
    "test:cov": "jest --selectProjects unit contract --coverage",
    "migration:run:dev": "ts-node src/database/run-migrations.ts",
    "test:ci:fast": "jest --selectProjects unit contract --ci --coverage --coverageReporters=cobertura --coverageReporters=html --coverageReporters=text-summary --reporters=default --reporters=jest-junit",
    "test:ci:containers": "jest --selectProjects integration e2e --ci --runInBand --reporters=default --reporters=jest-junit"
  },
  "dependencies": {
    "@langchain/core": "1.2.11",
    "@langchain/ollama": "1.3.0",
    "@langchain/textsplitters": "1.0.1",
    "@nestjs/common": "11.2.5",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/typeorm": "11.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "joi": "17.13.3",
    "kafkajs": "2.2.4",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.5",
    "@testcontainers/kafka": "11.14.0",
    "@testcontainers/postgresql": "11.14.0",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.30",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "jest-junit": "17.0.0",
    "supertest": "7.1.4",
    "testcontainers": "11.14.0",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "5.8.3"
  },
  "jest-junit": {
    "outputDirectory": "reports/junit",
    "suiteNameTemplate": "{displayName}: {filepath}",
    "classNameTemplate": "{classname}",
    "titleTemplate": "{title}",
    "addFileAttribute": "true"
  }
}
