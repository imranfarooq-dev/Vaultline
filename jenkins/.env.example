# Copy to jenkins/.env and adjust. Never commit the real file.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me-please

# Use a remote repository instead of the mounted folder, e.g. your GitHub fork:
# NESTBANK_REPO_URL=https://github.com/<you>/nest-banking-patterns.git
# NESTBANK_REPO_BRANCH=*/main

# Only needed for the Terraform/EKS stages (DEPLOY_ENV=dev|prod):
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
